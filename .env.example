NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/sydex
REDIS_URL=redis://127.0.0.1:6379
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-random-secret-at-least-32-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
EMAIL_OTP_PROVIDER=brevo
OTP_TTL_SECONDS=300
BREVO_API_KEY=add_key_in_local_env
EMAIL_FROM=your-verified-sender@example.com
EMAIL_FROM_NAME=Sydex
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
